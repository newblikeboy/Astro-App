# Local development only. Copy to .env; do not commit real credentials.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=127.0.0.1:8080
MONGODB_URI=
MONGODB_DATABASE=mishra4you_development
DATA_DIR=.local
EPHE_DIR=ephe
FONT_PATH=assets/NotoSansDevanagari-Regular.ttf
# Set this to your installed Chrome/Chromium executable when auto-detection fails.
CHROME_PATH=
ADMIN_EMAIL=local-admin@example.test
ADMIN_PASSWORD=local-admin-change-me
PAYMENT_MODE=simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false
OTP_MODE=simulation
OTP_GATEWAY_URL=
OTP_GATEWAY_TOKEN=
ZOOM_MODE=simulation
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me
NOTIFICATION_URL=
NOTIFICATION_TOKEN=
