# Production template. Install as /etc/mishra4you/app.env with mode 0600.
# Replace placeholders privately. Provider accounts and gateways are required.
ENV_FILE=none
APP_ENV=production
APP_ORIGIN=https://mishra4you.com
HTTP_ADDR=127.0.0.1:8080
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mishra4you_production
DATA_DIR=/var/lib/mishra4you
EPHE_DIR=/opt/mishra4you/ephe
FONT_PATH=/opt/mishra4you/assets/NotoSansDevanagari-Regular.ttf
CHROME_PATH=/usr/bin/google-chrome
HOME=/var/lib/mishra4you
GOMEMLIMIT=450MiB
GOMAXPROCS=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD_AT_LEAST_8_CHARACTERS
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
ALLOW_LIVE_PAYMENTS=false
ZOOM_MODE=zoom
ZOOM_ACCOUNT_ID=REPLACE_ME
ZOOM_CLIENT_ID=REPLACE_ME
ZOOM_CLIENT_SECRET=REPLACE_ME
ZOOM_USER_ID=me
NOTIFICATION_URL=https://REPLACE_NOTIFICATION_GATEWAY
NOTIFICATION_TOKEN=REPLACE_ME
