limit_req_zone $binary_remote_addr zone=m4y_auth:10m rate=10r/m;
server {
    listen 80;
    server_name replace-with-approved-domain;
    # Configure HTTPS with your approved certificate tooling before live use.
    client_max_body_size 5m;

    location ~ ^/api/(auth/|admin/login) {
        limit_req zone=m4y_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }
}
